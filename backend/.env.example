# ---------- Server ----------
PORT=4000
# On a server, set HOST=127.0.0.1 so only the reverse proxy can reach the app
HOST=
MONGO_URI=mongodb://localhost:27017/unified_matrix
# Allowed frontend origins, comma-separated (e.g. https://unified-matrix.vercel.app,http://localhost:4200)
CLIENT_ORIGIN=http://localhost:4200

# ---------- Auth (required) ----------
# Password you use to log in to the Angular app
ADMIN_PASSWORD=change-me
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- SMS (Android forwarder -> POST /webhooks/sms) ----------
# Long random string; the phone app sends it as "Authorization: Bearer <token>"
SMS_WEBHOOK_TOKEN=

# ---------- httpSMS (Android SMS via httpsms.com -> POST /webhooks/httpsms) ----------
# Long random string; paste the same value as "Signing key" when creating the webhook in httpSMS
HTTPSMS_SIGNING_KEY=

# ---------- WhatsApp Business (Cloud API -> GET/POST /webhooks/whatsapp) ----------
# Any long random string you choose; enter the same value as "Verify token" in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard -> App settings -> Basic -> App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=

# ---------- Telegram ----------
# 1. Get API ID + hash at https://my.telegram.org -> "API development tools"
# 2. Run `npm run telegram:login` and paste the printed session below
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Include broadcast channels (groups & private chats are always included)
TELEGRAM_INCLUDE_CHANNELS=false
# On startup, re-check the latest N messages of the top N chats (fills gaps while offline)
TELEGRAM_BACKFILL_DIALOGS=20
TELEGRAM_BACKFILL_PER_DIALOG=10

# ---------- Gmail (read-only) ----------
# 1. Google Cloud Console: enable Gmail API, create OAuth client (type: Desktop app or Web app
#    with redirect URI below), add yourself as a test user on the OAuth consent screen
# 2. Run `npm run gmail:auth` and paste the printed refresh token below
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4001/oauth2callback
GMAIL_REFRESH_TOKEN=
GMAIL_POLL_INTERVAL_SEC=15
GMAIL_BACKFILL_COUNT=25
